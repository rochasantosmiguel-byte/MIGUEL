<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Clicker Mania</title>

    <link rel="stylesheet" href="estilos.css">
</head>

<body>

    <div class="container">

        <h1>💰 Clicker Mania</h1>

        <p>Clique na moeda para ganhar dinheiro!</p>

        <div class="status">

            <div>
                💰 Moedas
                <strong id="moedas">0</strong>
            </div>

            <div>
                👆 Por clique
                <strong id="clique">1</strong>
            </div>

            <div>
                ⚙️ Por segundo
                <strong id="segundo">0</strong>
            </div>

        </div>

        <div class="game">

            <section class="clicker">

                <h2>🪙 Clique!</h2>

                <button id="botaoMoeda" class="moeda">
                    🪙
                </button>

                <p>
                    Cada clique:
                    <b id="valorClique">1</b>
                </p>

            </section>

            <section class="loja">

                <h2>🛒 Loja</h2>

                <button id="btnClique" class="upgrade">
                    ⚡ Clique Poderoso
                    <span>+1 por clique</span>
                    <small>
                        Custo: <b id="custoClique">10</b>
                    </small>
                </button>

                <button id="btnAuto" class="upgrade">
                    🤖 Minerador
                    <span>+1 por segundo</span>
                    <small>
                        Custo: <b id="custoAuto">50</b>
                    </small>
                </button>

                <button id="btnMega" class="upgrade">
                    🚀 Super Clique
                    <span>+10 por clique</span>
                    <small>
                        Custo: <b id="custoMega">250</b>
                    </small>
                </button>

                <button id="btnFabrica" class="upgrade">
                    🏭 Fábrica
                    <span>+10 por segundo</span>
                    <small>
                        Custo: <b id="custoFabrica">1000</b>
                    </small>
                </button>

            </section>

        </div>

        <button id="resetar" class="reset">
            🗑️ Resetar jogo
        </button>

    </div>

    <script src="logica.js"></script>

</body>
</html>
