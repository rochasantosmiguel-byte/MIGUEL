<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>💰 Clicker Mania</title>

  <link rel="stylesheet" href="estilos.css">
</head>

<body>

  <main class="game">

    <h1>💰 Clicker Mania</h1>
    <p class="subtitle">
      Clique na moeda e fique milionário!
    </p>

    <section class="stats">

      <div class="stat">
        <span>💰 Moedas</span>
        <strong id="moedas">0</strong>
      </div>

      <div class="stat">
        <span>👆 Por clique</span>
        <strong id="porClique">1</strong>
      </div>

      <div class="stat">
        <span>⚙️ Por segundo</span>
        <strong id="porSegundo">0</strong>
      </div>

    </section>

    <div class="layout">

      <section class="click-area">

        <h2>🪙 Clique!</h2>

        <button id="moeda" class="coin">
          🪙
        </button>

        <p>
          Cada clique vale
          <b id="forcaClique">1</b>
          moeda(s)
        </p>

      </section>


      <section class="shop">

        <h2>🛒 Loja</h2>

        <button class="upgrade" id="upgradeClique">

          <b>⚡ Clique Poderoso</b>

          <span>
            +1 moeda por clique
          </span>

          <small>
            Custo:
            <strong id="custoClique">25</strong>
          </small>

        </button>


        <button class="upgrade" id="upgradeAuto">

          <b>🤖 Minerador</b>

          <span>
            +1 moeda por segundo
          </span>

          <small>
            Custo:
            <strong id="custoAuto">100</strong>
          </small>

        </button>


        <button class="upgrade" id="upgradeMega">

          <b>🚀 Super Clique</b>

          <span>
            +10 moedas por clique
          </span>

          <small>
            Custo:
            <strong id="custoMega">500</strong>
          </small>

        </button>


        <button class="upgrade" id="upgradeFabrica">

          <b>🏭 Fábrica</b>

          <span>
            +10 moedas por segundo
          </span>

          <small>
            Custo:
            <strong id="custoFabrica">2000</strong>
          </small>

        </button>

      </section>

    </div>


    <button id="resetar" class="reset">
      🗑️ Resetar progresso
    </button>

  </main>


  <script src="logica.js"></script>

</body>
</html>
