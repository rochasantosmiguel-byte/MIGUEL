"use strict";


// ==========================================
// CONFIGURAÇÃO
// ==========================================

const SAVE_NAME = "clicker_mania_v2";


// ==========================================
// ESTADO DO JOGO
// ==========================================

let jogo = {
    moedas: 0,

    porClique: 1,

    porSegundo: 0,

    custoClique: 10,

    custoAuto: 50,

    custoMega: 250,

    custoFabrica: 1000
};


// ==========================================
// PEGAR ELEMENTOS
// ==========================================

const moedasElement =
    document.getElementById("moedas");

const cliqueElement =
    document.getElementById("clique");

const segundoElement =
    document.getElementById("segundo");

const valorCliqueElement =
    document.getElementById("valorClique");

const botaoMoeda =
    document.getElementById("botaoMoeda");

const btnClique =
    document.getElementById("btnClique");

const btnAuto =
    document.getElementById("btnAuto");

const btnMega =
    document.getElementById("btnMega");

const btnFabrica =
    document.getElementById("btnFabrica");

const resetar =
    document.getElementById("resetar");


// ==========================================
// CARREGAR
// ==========================================

function carregarJogo() {

    try {

        const salvo =
            localStorage.getItem(SAVE_NAME);

        if (!salvo) {

            return;

        }

        const dados =
            JSON.parse(salvo);

        if (typeof dados !== "object") {

            return;

        }

        jogo = {
            ...jogo,
            ...dados
        };

    } catch (erro) {

        console.warn(
            "Não foi possível carregar o save.",
            erro
        );

        localStorage.removeItem(SAVE_NAME);

    }

}


// ==========================================
// SALVAR
// ==========================================

function salvarJogo() {

    try {

        localStorage.setItem(
            SAVE_NAME,
            JSON.stringify(jogo)
        );

    } catch (erro) {

        console.warn(
            "Não foi possível salvar o jogo.",
            erro
        );

    }

}


// ==========================================
// ATUALIZAR INTERFACE
// ==========================================

function atualizarTela() {

    moedasElement.textContent =
        Math.floor(jogo.moedas);

    cliqueElement.textContent =
        jogo.porClique;

    segundoElement.textContent =
        jogo.porSegundo;

    valorCliqueElement.textContent =
        jogo.porClique;


    document.getElementById(
        "custoClique"
    ).textContent =
        jogo.custoClique;


    document.getElementById(
        "custoAuto"
    ).textContent =
        jogo.custoAuto;


    document.getElementById(
        "custoMega"
    ).textContent =
        jogo.custoMega;


    document.getElementById(
        "custoFabrica"
    ).textContent =
        jogo.custoFabrica;


    btnClique.disabled =
        jogo.moedas < jogo.custoClique;


    btnAuto.disabled =
        jogo.moedas < jogo.custoAuto;


    btnMega.disabled =
        jogo.moedas < jogo.custoMega;


    btnFabrica.disabled =
        jogo.moedas < jogo.custoFabrica;

}


// ==========================================
// CLIQUE NA MOEDA
// ==========================================

botaoMoeda.addEventListener(
    "click",
    function () {

        jogo.moedas +=
            jogo.porClique;

        salvarJogo();

        atualizarTela();

    }
);


// ==========================================
// UPGRADE: CLIQUE
// ==========================================

btnClique.addEventListener(
    "click",
    function () {

        if (
            jogo.moedas <
            jogo.custoClique
        ) {

            return;

        }

        jogo.moedas -=
            jogo.custoClique;

        jogo.porClique += 1;

        jogo.custoClique =
            Math.ceil(
                jogo.custoClique * 1.5
            );

        salvarJogo();

        atualizarTela();

    }
);


// ==========================================
// UPGRADE: AUTOMÁTICO
// ==========================================

btnAuto.addEventListener(
    "click",
    function () {

        if (
            jogo.moedas <
            jogo.custoAuto
        ) {

            return;

        }

        jogo.moedas -=
            jogo.custoAuto;

        jogo.porSegundo += 1;

        jogo.custoAuto =
            Math.ceil(
                jogo.custoAuto * 1.6
            );

        salvarJogo();

        atualizarTela();

    }
);


// ==========================================
// UPGRADE: SUPER CLIQUE
// ==========================================

btnMega.addEventListener(
    "click",
    function () {

        if (
            jogo.moedas <
            jogo.custoMega
        ) {

            return;

        }

        jogo.moedas -=
            jogo.custoMega;

        jogo.porClique += 10;

        jogo.custoMega =
            Math.ceil(
                jogo.custoMega * 2
            );

        salvarJogo();

        atualizarTela();

    }
);


// ==========================================
// UPGRADE: FÁBRICA
// ==========================================

btnFabrica.addEventListener(
    "click",
    function () {

        if (
            jogo.moedas <
            jogo.custoFabrica
        ) {

            return;

        }

        jogo.moedas -=
            jogo.custoFabrica;

        jogo.porSegundo += 10;

        jogo.custoFabrica =
            Math.ceil(
                jogo.custoFabrica * 2
            );

        salvarJogo();

        atualizarTela();

    }
);


// ==========================================
// PRODUÇÃO AUTOMÁTICA
// ==========================================

setInterval(
    function () {

        if (jogo.porSegundo <= 0) {

            return;

        }

        jogo.moedas +=
            jogo.porSegundo;

        salvarJogo();

        atualizarTela();

    },
    1000
);


// ==========================================
// RESET
// ==========================================

resetar.addEventListener(
    "click",
    function () {

        const confirmar =
            confirm(
                "Apagar todo o progresso?"
            );

        if (!confirmar) {

            return;

        }

        localStorage.removeItem(
            SAVE_NAME
        );

        location.reload();

    }
);


// ==========================================
// INICIAR JOGO
// ==========================================

carregarJogo();

atualizarTela();
