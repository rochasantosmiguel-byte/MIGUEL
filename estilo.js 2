console.log("Clicker Mania carregado!");

let moedas = 0;
let porClique = 1;
let porSegundo = 0;

let custoClique = 10;
let custoAuto = 50;
let custoMega = 250;
let custoFabrica = 1000;


// ELEMENTOS

const botaoMoeda = document.getElementById("botaoMoeda");

const moedasTexto = document.getElementById("moedas");
const cliqueTexto = document.getElementById("clique");
const segundoTexto = document.getElementById("segundo");
const valorCliqueTexto = document.getElementById("valorClique");

const btnClique = document.getElementById("btnClique");
const btnAuto = document.getElementById("btnAuto");
const btnMega = document.getElementById("btnMega");
const btnFabrica = document.getElementById("btnFabrica");


// ATUALIZAR TELA

function atualizarTela() {

    moedasTexto.textContent = Math.floor(moedas);

    cliqueTexto.textContent = porClique;

    segundoTexto.textContent = porSegundo;

    valorCliqueTexto.textContent = porClique;


    document.getElementById("custoClique").textContent =
        custoClique;

    document.getElementById("custoAuto").textContent =
        custoAuto;

    document.getElementById("custoMega").textContent =
        custoMega;

    document.getElementById("custoFabrica").textContent =
        custoFabrica;


    btnClique.disabled =
        moedas < custoClique;

    btnAuto.disabled =
        moedas < custoAuto;

    btnMega.disabled =
        moedas < custoMega;

    btnFabrica.disabled =
        moedas < custoFabrica;
}


// ========================================
// CLIQUE NA MOEDA
// ========================================

botaoMoeda.onclick = function () {

    moedas += porClique;

    atualizarTela();

    console.log("Clique! Moedas:", moedas);

};


// ========================================
// UPGRADE DE CLIQUE
// ========================================

btnClique.onclick = function () {

    if (moedas < custoClique) {
        return;
    }

    moedas -= custoClique;

    porClique += 1;

    custoClique =
        Math.ceil(custoClique * 1.5);

    atualizarTela();

};


// ========================================
// MINERADOR
// ========================================

btnAuto.onclick = function () {

    if (moedas < custoAuto) {
        return;
    }

    moedas -= custoAuto;

    porSegundo += 1;

    custoAuto =
        Math.ceil(custoAuto * 1.6);

    atualizarTela();

};


// ========================================
// SUPER CLIQUE
// ========================================

btnMega.onclick = function () {

    if (moedas < custoMega) {
        return;
    }

    moedas -= custoMega;

    porClique += 10;

    custoMega =
        Math.ceil(custoMega * 2);

    atualizarTela();

};


// ========================================
// FÁBRICA
// ========================================

btnFabrica.onclick = function () {

    if (moedas < custoFabrica) {
        return;
    }

    moedas -= custoFabrica;

    porSegundo += 10;

    custoFabrica =
        Math.ceil(custoFabrica * 2);

    atualizarTela();

};


// ========================================
// MOEDAS AUTOMÁTICAS
// ========================================

setInterval(function () {

    moedas += porSegundo;

    atualizarTela();

}, 1000);


// INICIAR

atualizarTela();
