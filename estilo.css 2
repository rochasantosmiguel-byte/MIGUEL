* {
    box-sizing: border-box;
}

body {
    margin: 0;

    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    font-family: Arial, sans-serif;

    color: white;

    background:
        radial-gradient(
            circle at top,
            #673ab7,
            #12091f 70%
        );

    padding: 20px;
}

.container {
    width: 100%;
    max-width: 900px;

    text-align: center;
}

h1 {
    margin: 0;

    font-size: 48px;

    color: #ffd740;

    text-shadow:
        0 0 20px #ff9800;
}

.container > p {
    color: #ccc;

    margin-bottom: 25px;
}


/* STATUS */

.status {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 15px;

    margin-bottom: 20px;
}

.status div {
    padding: 15px;

    border-radius: 15px;

    background: #ffffff12;

    border: 1px solid #ffffff22;
}

.status strong {
    display: block;

    margin-top: 7px;

    font-size: 25px;

    color: #ffd740;
}


/* JOGO */

.game {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 20px;
}


/* CLICKER */

.clicker,
.loja {
    padding: 25px;

    border-radius: 20px;

    background: #ffffff10;

    border: 1px solid #ffffff22;
}

.clicker h2,
.loja h2 {
    margin-top: 0;
}


/* MOEDA */

.moeda {
    width: 220px;
    height: 220px;

    margin: 25px auto;

    display: flex;
    justify-content: center;
    align-items: center;

    border-radius: 50%;

    border: 10px solid #f6a800;

    background:
        radial-gradient(
            circle at 35% 25%,
            #fff59d,
            #ffd740 45%,
            #e68a00
        );

    box-shadow:
        0 0 40px #ffb300aa,
        inset 0 -12px 0 #bd6d00;

    font-size: 80px;

    cursor: pointer;

    transition: 0.1s;
}

.moeda:hover {
    transform: scale(1.05);
}

.moeda:active {
    transform: scale(0.9);
}


/* UPGRADES */

.upgrade {
    width: 100%;

    margin-bottom: 10px;

    padding: 15px;

    border: none;

    border-radius: 12px;

    background: #673ab7;

    color: white;

    text-align: left;

    font-size: 16px;

    cursor: pointer;

    transition: 0.15s;
}

.upgrade:hover:not(:disabled) {
    background: #7e57c2;

    transform: translateY(-2px);
}

.upgrade:disabled {
    opacity: 0.4;

    cursor: not-allowed;
}

.upgrade span,
.upgrade small {
    display: block;

    margin-top: 5px;
}

.upgrade small {
    color: #ffd740;
}


/* RESET */

.reset {
    margin-top: 20px;

    padding: 12px 20px;

    border: none;

    border-radius: 10px;

    background: #e53935;

    color: white;

    cursor: pointer;
}

.reset:hover {
    background: #f44336;
}


/* CELULAR */

@media (max-width: 700px) {

    .status {
        grid-template-columns: 1fr;
    }

    .game {
        grid-template-columns: 1fr;
    }

    h1 {
        font-size: 36px;
    }

    .moeda {
        width: 180px;
        height: 180px;

        font-size: 65px;
    }

}
